# BEGIN portalshit
BIN=/var/www/deploys/portalshit/current/bin

# today (hourly)
*/5 * * * * $BIN/hourly_stats

# daily (0:05〜)
5 0 * * * $BIN/daily_stats_yesterday
6 0 * * * $BIN/daily_stats_all
8 0 * * * $BIN/log_backup
9 0 * * * $BIN/db_backup

# maintenance (every 10min)
*/10 * * * * $BIN/run_update_search_index
*/10 * * * * $BIN/run_update_similarity

# weekly full rebuild (Sunday 4:00)
0 4 * * 0 $BIN/run_update_similarity true
0 5 * * 0 $BIN/run_update_search_index true

# knowledge touch (every 5 days)
0 3 */5 * * $BIN/run_knowledge_touch

# 500 error mail (every 5 min)
*/5 * * * * $BIN/notify_errors 2>> /var/www/app/portalshit/log/notify_errors.log
# END portalshit
