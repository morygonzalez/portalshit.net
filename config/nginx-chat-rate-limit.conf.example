# Dify チャット API のレート制限（nginx 側で設定する）。
#
# アプリ側では Origin / Referer が自サイトのものかを見て弾いているが、
# ヘッダは偽装できるので、これ単体では総量を抑えられない。本番の Puma は
# workers 1 × threads 2,8 で最大 8 スレッドしかなく、特に SSE で応答する
# /api/chat/messages は 1 リクエストが応答完了までスレッドを占有するため、
# 同時接続数を絞らないとサイト全体が 504 になる。
#
# アプリ側にも同時ストリーム数の上限（既定 4 本、超過分は 429）があり、
# そちらが最終的な保険。ここでの制限は Puma までリクエストを届かせないための
# 前段の防御。
#
# 反映方法:
#   1. http {} の中身を nginx.conf（または conf.d/*.conf）へ
#   2. server {} の中身を portalshit.net の server ブロックへ
#   3. sudo nginx -t && sudo systemctl reload nginx

# --- http {} コンテキスト ---------------------------------------------------

# SSE の同時接続数（サイト全体）を制限する。
# Puma の 8 スレッドのうち半分までをチャットに許し、残りを記事ページ用に残す。
limit_conn_zone $server_name zone=chat_conn_global:10m;

limit_conn_status 429;

# --- server {} コンテキスト -------------------------------------------------
# proxy_pass / proxy_set_header の行は既存の location の設定に合わせること。

location = /api/chat/messages {
    limit_conn chat_conn_global 4;

    # SSE なのでバッファリングとタイムアウトの設定が必要（既存設定があれば流用）
    proxy_buffering off;
    proxy_read_timeout 300s;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://app;
}

location ^~ /api/chat/ {

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://app;
}
