- if @comment and !@comment.errors.empty?
  #error
    .title= t('error')
    %ul
      - @comment.errors.each do |error|
        %li= error
- if disabled
  %p= t('comment.closed')
- else
  %form{action: request.path_info, method: 'post', id: 'comment_form'}
    :javascript
      document.write('<input type="hidden" name="check" value="check" />');
    %p
      %label{for: 'comment_name'}= t('comment.name')
      %br
      %input{type: 'text', name: 'comment[name]', id: 'comment_name'}
    %p
      %label{for: 'comment_email'}
        = t('user.email')
        %span.required *
      %br
      %input{type: 'email', name: 'comment[email]', id: 'comment_email', required: true}
    %p
      %label{for: 'comment_homepage'}= t('comment.homepage')
      == (#{t('option')})
      %br
      %input{type: 'text', name: 'comment[homepage]', id: 'comment_homepage'}
    %p
      %label{for: 'comment_body'}= t('comment.body')
      %br
      %textarea{name: 'comment[body]', id: 'comment_body'}
    - if ENV['RECAPTCHA_PUBLIC_KEY'] && ENV['RECAPTCHA_PRIVATE_KEY']
      %p
        != recaptcha_javascript
        != recaptcha_widget
    %fieldset.comment-visibility
      %legend= t('theme.comment.mode.label')
      .comment-visibility-tabs{role: 'tablist'}
        %input.comment-visibility-input{type: 'radio', name: 'comment[private]', id: 'comment_public', value: '0', checked: !(@comment&.private?), 'aria-label' => t('theme.comment.mode.public')}
        %label{for: 'comment_public', role: 'tab'}= t('theme.comment.mode.public')
        %input.comment-visibility-input{type: 'radio', name: 'comment[private]', id: 'comment_private', value: '1', checked: @comment&.private?, 'aria-describedby' => 'comment_private_note', 'aria-label' => t('theme.comment.mode.private')}
        %label{for: 'comment_private', role: 'tab'}= t('theme.comment.mode.private')
      %small.comment-visibility-note.comment-visibility-public= t('theme.comment.note')
      %small#comment_private_note.comment-visibility-note.comment-visibility-private= t('theme.comment.private.explanation')
    %input.button.comment-submit.comment-submit-public{type: 'submit', value: t('theme.comment.submit.public')}
    %input.button.comment-submit.comment-submit-private{type: 'submit', value: t('theme.comment.submit.private')}
