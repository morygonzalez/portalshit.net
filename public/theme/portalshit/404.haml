%section#not_found_description
  %p.not-found-code 404 Not Found
  %h2 ページが見つかりませんでした
  .description
    %p お探しのページは移動または削除された可能性があります。
    %p.not-found-path
      %span お探しの URL
      %code= request.path_info
    %p= link_to 'トップページへ戻る', '/', class: 'not-found-home'

%section#not_found_search
  %h2= t('search')
  .search-field
    %form{ action: '/search/', method: 'get', role: 'search' }
      %label{ for: 'not-found-query' } キーワードから記事を探す
      .not-found-search-controls
        %input#not-found-query{ type: 'search', name: 'query', placeholder: 'キーワードを入力', value: params[:query] }
        %button{ type: 'submit' } 検索
    %p
      よく検索されているキーワード:
      = cache_fragment :not_found_frequently_search_term, shared: true, expires_in: 2.hours do
        - popular_keywords.each do |keyword|
          %span.keyword= link_to keyword, %(/search/?query=#{keyword})

= partial :_recent_entries, locals: { posts: Entry.includes(:category).published.recent(7).to_a }

%section.category-cards
  %h2= t('categories')
  - categories = sorted_categories
  - latest_posts = latest_posts_by_category(categories)
  - entry_lengths = published_post_counts_by_category
  = partial :_category_cards, locals: { categories: categories, latest_posts: latest_posts, entry_lengths: entry_lengths }
