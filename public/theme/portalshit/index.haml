%section#site_description
  %h2= t('about')
  .description= @site.description

%article#recent_entries
  %h2= t('recent_entries')
  %section.recent
    - if post = @posts.first
      .new-entry
        = partial :_main_entry, locals: { post: post }
      .past-entries
        - @posts.each_with_index do |post, index|
          - next if index == 0
          = partial :_other_entries, locals: { post: post }

%section#popular_entries
  %h2= link_to t('popular_entries'), '/popular'
  %section
    = cache_fragment :"index-poular-articles-#{I18n.locale}", expires_in: 1.hour do
      %section.entries-list.frequently-read-articles
        %h3= link_to '最近よく読まれている記事', '/popular/recent'
        .items
          - Entry.includes(:category).popular(limit: 6).each do |post|
            = partial :_entry_list_item, locals: { post: post, type: 'frequency' }
      %section.entries-list.hotentry
        %h3= link_to 'はてなブックマークで注目を集めた記事', '/popular/hatena-bookmark'
        .items
          - Entry.includes(:category).hotentry(limit: 6).each do |post|
            = partial :_entry_list_item, locals: { post: post, type: 'hotentry', show_bookmark_count: true }
