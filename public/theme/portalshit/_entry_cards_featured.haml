.entry
  %h3.title{ itemprop: 'name' }
    = link_to post.title, post.link, itemprop: 'url'
  .meta
    %time{ datetime: post.created_at.to_fs(:db) }= l(post.created_at.to_date, format: :long)
  %aside{ style: 'display: none'}
    %meta{ content: post.link, itemprop: 'mainEntityOfPage', itemscope: true, itemtype: 'https://schema.org/WebPage' }
    %time{ datetime: post.created_at.to_fs(:db), itemprop: 'datePublished' }= post.created_at
    %time{ datetime: post.updated_at.to_fs(:db), itemprop: 'dateModified' }= post.updated_at
    %span{ itemprop: 'headline' }= post.long_description
    %div{ itemprop: :publisher, itemscope: true, itemtype: 'https://schema.org/Person' }
      %div{ itemprop: 'logo', itemscope: true, itemtype: 'https://schema.org/ImageObject' }
        %meta{ content: 'https://2.gravatar.com/avatar/aca7b71389633fab164383ed343f080f%3F', itemprop: :url }
        %meta{ content: '128', itemprop: :width }
        %meta{ content: '128', itemprop: :height }
      %meta{ content: 'morygonzalez', itemprop: :name }
    %div{ itemprop: :image, itemscope: true, itemtype: 'https://schema.org/ImageObject' }
      %meta{ itemprop: :url, content: "https://portalshit.net/imageproxy/350x/#{post.cover_image}" }
      %meta{ itemprop: :width, content: 350 }
      %meta{ itemprop: :height, content: 255 }
  .content
    .image
      - if post.images.present?
        %a{ href: post.link }
          %picture
            = image_tag "https://portalshit.net/imageproxy/640x/#{post.cover_image}", srcset: "https://portalshit.net/imageproxy/320x/#{post.cover_image} 320w, https://portalshit.net/imageproxy/640x/#{post.cover_image} 640w, https://portalshit.net/imageproxy/960x/#{post.cover_image} 960w, https://portalshit.net/imageproxy/1280x/#{post.cover_image} 1280w", sizes: '(max-width: 640px) calc(100vw - 1em), (max-width: 1279px) calc(90vw - 60px), (max-width: 1421px) calc(45vw - 30px), 610px'
      - else
        = link_to image_tag("https://portalshit.net/imageproxy/330/#{post.cover_image}", srcset: "https://portalshit.net/imageproxy/330/#{post.cover_image} 1x, https://portalshit.net/imageproxy/660/#{post.cover_image} 2x", class: 'default'), post.link
    .summary
      .body{ itemprop: 'articleBody' }
        = post.summary_or_description
  .footer
    = post.tags_to_html
    .comment== #{link_to "#{t('comments')} (#{post.public_comments.size})", "#{post.link}#comment_form"}
