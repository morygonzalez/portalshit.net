%link{ href: 'https://cdn.quilljs.com/1.3.6/quill.snow.css', rel: 'stylesheet' }

= form_for @entry, action, method: method, id: 'entry' do |f|
  #form-main
    - unless @entry.errors.empty?
      #error
        .title= t('error')
        %ul
          - @entry.errors.each do |error|
            %li= error
    .field.title
      = f.label :title, caption: t("#{@name}.title")
      %br/
      = f.text_field :title
    .field.markup
      = f.label :markup, caption: 'Markup'
      %br/
      = f.select :markup, options: Markup.engine_list.map {|e| [e[1], e[0]] }
    .field.body
      = f.label :body, caption: t("#{@name}.body")
      %ul.preview-edit
        %li.selected
          = label_tag :edit, for: 'preview-edit', caption: 'Edit'
          = radio_button_tag :ipreview, value: 'edit', checked: true, id: 'preview-edit'
        %li
          = label_tag :preview, for: 'preview-preview', caption: 'Preview'
          = radio_button_tag :ipreview, value: 'preview', id: 'preview-preview'
      #editor
        %textarea.editor{ id: "#{@name}_body", name: "#{@name}[body]", cols: 50 }= @entry.raw_body
      .image-picker
        %label.image-picker__button{ for: "#{@name}_image_picker" }
          %svg.image-picker__icon{ xmlns: 'http://www.w3.org/2000/svg', viewBox: '0 0 24 24', 'aria-hidden': 'true', focusable: 'false' }
            %rect{ x: '3', y: '4', width: '18', height: '16', rx: '2', ry: '2', fill: 'none', stroke: 'currentColor', 'stroke-width': '2' }
            %circle{ cx: '8.5', cy: '9.5', r: '1.5', fill: 'currentColor' }
            %path{ d: 'M4 17l5-5 3 3 4-4 4 4', fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
          %span.visually-hidden= t('image_picker_label')
        %input.image-picker__input{ id: "#{@name}_image_picker", type: :file, accept: 'image/*', multiple: true, hidden: true }
        %span.image-picker__status{ 'aria-live': 'polite' }
      .photo-gallery-picker
        %label.photo-gallery-picker__button{ for: "#{@name}_gallery_picker" }
          %svg.photo-gallery-picker__icon{ xmlns: 'http://www.w3.org/2000/svg', viewBox: '0 0 24 24', 'aria-hidden': 'true', focusable: 'false' }
            %rect{ x: '7', y: '3', width: '14', height: '14', rx: '2', ry: '2', fill: 'none', stroke: 'currentColor', 'stroke-width': '2' }
            %path{ d: 'M17 21H5a2 2 0 0 1-2-2V7', fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round' }
            %path{ d: 'M8 13l3-3 2 2 3-3 5 5', fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }
          %span.visually-hidden= t('photo_gallery_picker_label')
        %input.photo-gallery-picker__input{ id: "#{@name}_gallery_picker", type: :file, accept: 'image/*', multiple: true, hidden: true }
        %span.photo-gallery-picker__status{ 'aria-live': 'polite' }
      .gallery-review{ hidden: true }
        .gallery-review__inner
          %h3.gallery-review__heading= t('gallery_review.heading')
          %p.gallery-review__description= t('gallery_review.description')
          %ul.gallery-review__list
          .gallery-review__actions
            %button.button.gallery-review__insert{ type: :button }= t('gallery_review.insert')
            %button.button.gallery-review__cancel{ type: :button }= t('gallery_review.cancel')
      #preview
  #form-aside
    .field.slug
      = f.label :slug, caption: t("#{@name}.slug")
      %br/
      = f.text_field :slug
      - if @entry.persisted? && @entry.slug?
        = link_to @entry.link, @entry.link, target: '_blank'
    .field.category
      = f.label :category, caption: t("#{@name}.category")
      %br/
      - if Category.count > 0
        = f.select :category_id, collection: Category.all, fields: [:title, :id], include_blank: t('not_select')
      - else
        = t('no_category')
    .field.summary
      = f.label :summary, caption: 'Summary'
      %br/
      = f.text_area :summary, rows: 10, placeholder: 'まだ要約はありません'
      %div
        = f.label :generate_or_update_summary, caption: '要約を自動生成'
        = f.check_box :generate_or_update_summary
    .field.tags
      = f.label :tag_collection, caption: t("#{@name}.tags")
      %br/
      = f.text_field :tag_collection
      %div
        = f.label :auto_generate_tags, caption: 'タグを自動生成'
        = f.check_box :auto_generate_tags
    - @field_names.each do |field_name|
      .field
        = label_tag "#{@name}_fields_#{field_name.name}", caption: field_name.name
        %br/
        = text_field_tag "#{@name}[fields][#{field_name.name}]", id: "#{@name}_fields_#{field_name.name}", value: "#{@entry.new_record? ? (params[@name] ? params[@name]['fields'][field_name.name] : '') : @entry.send(field_name.name)}"
    .field.publish_at
      = f.label :publish_at, caption: t("#{@name}.publish_at")
      %br/
      = f.text_field :publish_at, type: 'datetime-local', value: @entry.publish_at&.strftime("%Y-%m-%dT%H:%M")
      %small 空欄 = 下書き / 過去・現在 = 公開 / 未来 = 予約投稿
    .field.created_at
      = f.label :created_at, caption: t("#{@name}.created_at")
      %br/
      = f.text_field :created_at, type: 'datetime-local', value: @entry.persisted? ? @entry.created_at.strftime("%Y-%m-%dT%H:%M") : Time.now.strftime("%Y-%m-%dT%H:%M")
    = f.hidden_field :updated_at
    %p
      %input{ type: :submit, value: t('preview'), name: :preview, formtarget: :_blank }
      %input{ type: :submit, value: label, name: :edit }

:css
  .ql-snow.ql-toolbar:after, .ql-snow .ql-toolbar:after {
    clear: none;
  }
