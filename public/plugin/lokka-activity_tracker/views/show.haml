  splits_title: t('activity_tracker.js.splits_title', default: 'Splits (per km)'),
  chart_empty: t('activity_tracker.js.chart_empty', default: 'No data available'),
  chart_time_label: t('activity_tracker.js.chart_time_label', default: 'Time'),
  metric_show_label: t('activity_tracker.js.metric_show_label', default: 'Show:'),
  metric_heart_rate: t('activity_tracker.js.metric_heart_rate', default: 'Heart Rate'),
  metric_pace: t('activity_tracker.js.metric_pace', default: 'Pace'),
  metric_altitude: t('activity_tracker.js.metric_altitude', default: 'Altitude'),
  metric_cadence: t('activity_tracker.js.metric_cadence', default: 'Cadence'),
  metric_power: t('activity_tracker.js.metric_power', default: 'Power'),
  metric_distance: t('activity_tracker.js.metric_distance', default: 'Distance'),
  metric_duration: t('activity_tracker.js.metric_duration', default: 'Duration'),
