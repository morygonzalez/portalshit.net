.activity-detail
  %h2= @activity.title

  .activity-summary
    .activity-stats-grid
      - if @activity.started_at
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.started_at', default: 'Date')
          %div.activity-stat-value= @activity.started_at.strftime('%Y-%m-%d %H:%M')

      - if @activity.activity_type
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.type', default: 'Type')
          %div.activity-stat-value= @activity.activity_type.capitalize

      - if @activity.device_display_label
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.device', default: 'Device')
          %div.activity-stat-value= @activity.device_display_label

      - if @activity.formatted_distance
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.distance', default: 'Distance')
          %div.activity-stat-value= @activity.formatted_distance

      - if @activity.formatted_duration
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.duration', default: 'Duration')
          %div.activity-stat-value= @activity.formatted_duration

      - if @activity.formatted_pace
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.avg_pace', default: 'Avg Pace')
          %div.activity-stat-value= @activity.formatted_pace

      - if @activity.formatted_best_pace
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.best_pace', default: 'Best Pace')
          %div.activity-stat-value= @activity.formatted_best_pace

      - if @activity.avg_heart_rate
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.avg_hr', default: 'Avg Heart Rate')
          %div.activity-stat-value= "#{@activity.avg_heart_rate} bpm"

      - if @activity.max_heart_rate
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.max_hr', default: 'Max Heart Rate')
          %div.activity-stat-value= "#{@activity.max_heart_rate} bpm"

      - if @activity.total_ascent_meters
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.elevation', default: 'Elevation Gain')
          %div.activity-stat-value= "#{@activity.total_ascent_meters.round} m"

      - if @activity.avg_cadence
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.cadence', default: 'Avg Cadence')
          %div.activity-stat-value= "#{@activity.avg_cadence} spm"

      - if @activity.avg_power
        .activity-stat
          %div.activity-stat-label= t('activity_tracker.power', default: 'Avg Power')
          %div.activity-stat-value= "#{@activity.avg_power} W"

#activity-root{data: {activity_id: @activity.id}}

%link{rel: "stylesheet", href: "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css", integrity: "sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=", crossorigin: ""}
%script{src: "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js", integrity: "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=", crossorigin: ""}
%script{src: "#{asset_path(activity_tracker_javascript_path('index.js'))}"}
