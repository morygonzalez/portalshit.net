:css
  #activity-upload-form {
    margin: 1em auto 1.5em;
  }
  .type-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 8px 0 12px;
  }
  .type-filter .filter-label {
    font-size: 0.9em;
    margin-right: 6px;
  }
  .type-filter-button {
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.85em;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .type-filter-button:hover {
    border-color: rgba(0, 0, 0, 0.35);
  }
  .type-filter-button.current {
    border-color: rgba(0, 0, 0, 0.35);
    background: rgba(0, 0, 0, 0.08);
    font-weight: 600;
  }

%h2= t('activity_tracker.admin.title', default: 'Manage Activities')

%form#activity-upload-form{enctype: 'multipart/form-data'}
  .form-group
    %label{for: 'file'}= t('activity_tracker.file_label', default: 'Activity File (FIT or GPX)')
    -# iOS Safari doesn't recognize .fit files, so we use a permissive accept with */*
    %div
      %input.form-control{type: 'file', name: 'file', id: 'file', accept: '.fit,.gpx,.zip,*/*', required: true}
      %button.btn.btn-primary{type: 'submit'}= t('activity_tracker.upload', default: 'Upload')

#upload-status

%div.search
  %form(action="/admin/activities" method="get")
    - if @selected_type
      %input{ type: 'hidden', name: 'type', value: @selected_type }
    %input{ type: 'search', name: 'query', placeholder: "Search", value: "#{params[:query]}" }

- query_param = @query.present? ? "&query=#{Rack::Utils.escape_html(@query)}" : ""
- available_types = Lokka::ActivityTracker::Activity.available_activity_types
.type-filter
  %span.filter-label= t('activity_tracker.filter_by_type', default: 'Filter:')
  %a.type-filter-button{href: "/admin/activities#{@query.present? ? "?query=#{Rack::Utils.escape_html(@query)}" : ''}", class: ('current' unless @selected_type)}= t('activity_tracker.filter_all', default: 'All')
  - Lokka::ActivityTracker::Activity::ACTIVITY_TYPE_GROUPS.each do |group, member_types|
    - if (member_types & available_types).any?
      %a.type-filter-button{href: "/admin/activities?type=#{group}#{query_param}", class: ('current' if @selected_type == group)}= t("activity_tracker.activity_types.#{group}", default: group.tr('_', ' ').capitalize)
  - Lokka::ActivityTracker::Activity::ACTIVITY_TYPES.each do |type|
    - if available_types.include?(type)
      %a.type-filter-button{href: "/admin/activities?type=#{type}#{query_param}", class: ('current' if @selected_type == type)}= t("activity_tracker.activity_types.#{type}", default: type.tr('_', ' ').capitalize)

#table_wrapper
  %table.activities
    %tr
      %th= t('activity_tracker.title_label', default: 'Title')
      %th= t('activity_tracker.type', default: 'Type')
      %th= t('activity_tracker.started_at', default: 'Date')
      %th= t('activity_tracker.distance', default: 'Distance')
      %th= t('activity_tracker.duration', default: 'Duration')
      %th= t('activity_tracker.avg_pace', default: 'Avg Pace')
      %th= t('activity_tracker.elevation', default: 'Elevation Gain')
      %th{ colspan: 3 }
    - @activities.each_with_index do |activity, i|
      %tr{ class: (i + 1).odd? ? :odd : :even }
        %td.title= link_to activity.title, url("/activities/#{activity.file_hash}")
        %td= activity.localized_activity_type
        %td= activity.started_at&.strftime('%Y-%m-%d %H:%M')
        %td= activity.formatted_distance
        %td= activity.formatted_duration
        %td= activity.formatted_pace
        %td= activity.total_ascent_meters ? "#{activity.total_ascent_meters.round} m" : nil
        %td= link_to '📋', '#', class: 'copy-embed-btn', style: 'font-size: 2em; text-decoration: none; line-height: 1;', data: { shortcode: "[activity:#{activity.file_hash[0, 8]}]" }, title: t('activity_tracker.copy_embed_tooltip', default: 'Copy embed code')
        %td= link_to t('edit'), url("/admin/activities/#{activity.id}/edit"), class: :button
        %td= link_to t('delete'), url("/admin/activities/#{activity.id}"), class: :button, confirm: t('are_you_sure'), method: :delete

.pager
  = paginate @activities

:javascript
  document.getElementById('activity-upload-form').addEventListener('submit', function(e) {
    e.preventDefault();

    var formData = new FormData(this);
    var status = document.getElementById('upload-status');
    var submitButton = this.querySelector('button[type="submit"]');
    if (submitButton) {
      submitButton.disabled = true;
    }
    status.innerHTML = '<p>Uploading... This may take a while.</p>';

    fetch('/admin/activities', {
      method: 'POST',
      body: formData
    }).then(function(response) {
      var contentType = response.headers.get('content-type') || '';
      var isJson = contentType.indexOf('application/json') !== -1;
      var parseBody = isJson ? response.json() : response.text();

      if (!response.ok) {
        return parseBody.then(function(body) {
          var message = isJson && body && body.error ? body.error : (body && body.trim ? body.trim() : '');
          throw new Error(message || response.statusText || 'Upload failed');
        });
      }

      return parseBody;
    }).then(function(data) {
      if (data && data.results) {
        // ZIP file response
        var successCount = data.results.filter(function(r) { return r.success; }).length;
        var failCount = data.results.length - successCount;
        var html = '<p><strong>Upload complete: ' + successCount + ' succeeded'
          + (failCount > 0 ? (', ' + failCount + ' failed') : '')
          + '</strong></p>';
        for (var i = 0; i < data.results.length; i++) {
          var r = data.results[i];
          if (r.success) {
            html += '<p class="text-success">✓ ' + r.filename + '</p>';
          } else {
            html += '<p class="text-danger">✗ ' + r.filename + ' - ' + r.error + '</p>';
          }
        }
        if (successCount > 0) {
          html += '<p><a href="/admin/activities">Back to activities list</a></p>';
        }
        status.innerHTML = html;
        if (submitButton) submitButton.disabled = false;
      } else if (data && data.success) {
        status.innerHTML = '<p class="text-success">Upload successful! Redirecting...</p>';
        window.location.href = data.redirect_url;
      } else {
        var message = data && data.error ? data.error : 'Upload failed';
        status.innerHTML = '<p class="text-danger">Error: ' + message + '</p>';
        if (submitButton) {
          submitButton.disabled = false;
        }
      }
    }).catch(function(error) {
      status.innerHTML = '<p class="text-danger">Error: ' + error.message + '</p>';
      if (submitButton) {
        submitButton.disabled = false;
      }
    });
  });

  document.querySelectorAll('.copy-embed-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var shortcode = this.dataset.shortcode;
      var originalText = this.textContent;
      var button = this;

      navigator.clipboard.writeText(shortcode).then(function() {
        button.textContent = '✅';
        setTimeout(function() {
          button.textContent = originalText;
        }, 1500);
      }).catch(function() {
        // Fallback for older browsers
        var textarea = document.createElement('textarea');
        textarea.value = shortcode;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        button.textContent = '✅';
        setTimeout(function() {
          button.textContent = originalText;
        }, 1500);
      });
    });
  });
