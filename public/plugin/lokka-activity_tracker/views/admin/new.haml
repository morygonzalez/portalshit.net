%h2= t('activity_tracker.admin.new', default: 'Upload Activity')

%form#activity-upload-form{enctype: 'multipart/form-data'}
  .form-group
    %label{for: 'title'}= t('activity_tracker.title_label', default: 'Title')
    %input.form-control{type: 'text', name: 'title', id: 'title', placeholder: t('activity_tracker.title_placeholder', default: 'Leave blank to use filename')}

  .form-group
    %label{for: 'file'}= t('activity_tracker.file_label', default: 'Activity File (FIT or GPX)')
    %input.form-control{type: 'file', name: 'file', id: 'file', accept: '.fit,.gpx', required: true}

  .form-group
    %button.btn.btn-primary{type: 'submit'}= t('activity_tracker.upload', default: 'Upload')

#upload-status

:javascript
  document.getElementById('activity-upload-form').addEventListener('submit', function(e) {
    e.preventDefault();

    var formData = new FormData(this);
    var status = document.getElementById('upload-status');
    status.innerHTML = '<p>Uploading...</p>';

    fetch('/admin/activities', {
      method: 'POST',
      body: formData
    }).then(function(response) {
      return response.json();
    }).then(function(data) {
      if (data.success) {
        status.innerHTML = '<p class="text-success">Upload successful! Redirecting...</p>';
        window.location.href = data.redirect_url;
      } else {
        status.innerHTML = '<p class="text-danger">Error: ' + data.error + '</p>';
      }
    }).catch(function(error) {
      status.innerHTML = '<p class="text-danger">Error: ' + error.message + '</p>';
    });
  });
