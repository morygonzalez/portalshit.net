:css
  .activities th {
    text-align: center;
  }
  .activities th.title {
    width: 26%;
  }
  .activities th.typw {
    width: 15%;
  }
  .activities th.date {
    width: 15%;
  }
  .activities th.distance,
  .activities th.duration,
  .activities th.pace,
  .activities th.elevation {
    width: 11%;
  }
  .activities td.type,
  .activities td.date {
    white-space: nowrap;
  }
  .activities td.distance,
  .activities td.duration,
  .activities td.pace,
  .activities td.elevation {
    text-align: right;
    white-space: nowrap;
  }
  .activity-month-summary {
    font-size: 0.7em;
    font-weight: normal;
    font-family: "ヒラギノ丸ゴ Pro W4","ヒラギノ丸ゴ Pro","Hiragino Maru Gothic Pro","ヒラギノ角ゴ Pro W3","Hiragino Kaku Gothic Pro","Lucida Sans";
  }
  .activity-month-summary .activity-stat-label {
    font-size: inherit;
  }
  .activity-month-summary .activity-stat-value {
    font-size: inherit;
  }

.activities-list
  - if @selected_year
    %h2= "#{t('activity_tracker.title', default: 'Activities')} #{@selected_year}"
  - else
    %h2= t('activity_tracker.title', default: 'Activities')

  - if @available_years && @available_years.any?
    .year-navigation.metric-selector
      %span.metric-selector-label= t('activity_tracker.year_archives', default: 'Archives:')
      %a.metric-button{href: '/activities', class: ('active' unless @selected_year)}= t('activity_tracker.recent', default: 'Recent')
      - @available_years.each do |year|
        %a.metric-button{href: "/activities/#{year}", class: ('active' if @selected_year == year)}= year

  - base_path = @selected_year ? "/activities/#{@selected_year}" : '/activities'
  - available_types = Lokka::ActivityTracker::Activity.available_activity_types
  .type-filter.metric-selector
    %span.metric-selector-label= t('activity_tracker.filter_by_type', default: 'Filter:')
    %a.metric-button{href: base_path, class: ('active' unless @selected_type)}= t('activity_tracker.filter_all', default: 'All')
    - Lokka::ActivityTracker::Activity::ACTIVITY_TYPE_GROUPS.each do |group, member_types|
      - if (member_types & available_types).any?
        %a.metric-button{href: "#{base_path}?type=#{group}", class: ('active' if @selected_type == group)}= t("activity_tracker.activity_types.#{group}", default: group.tr('_', ' ').capitalize)
    - Lokka::ActivityTracker::Activity::ACTIVITY_TYPES.each do |type|
      - if available_types.include?(type)
        %a.metric-button{href: "#{base_path}?type=#{type}", class: ('active' if @selected_type == type)}= t("activity_tracker.activity_types.#{type}", default: type.tr('_', ' ').capitalize)

  .monthly-stats
    %h3= t('activity_tracker.monthly_summary', default: 'Monthly Summary')
    #monthly-stats-chart{data: {year: @selected_year, type: @selected_type, i18n: {
      monthly_loading: t('activity_tracker.js.monthly_loading', default: 'Loading...'),
      monthly_empty: t('activity_tracker.js.monthly_empty', default: 'No data available'),
      monthly_distance: t('activity_tracker.js.monthly_distance', default: 'Distance'),
      monthly_elevation: t('activity_tracker.js.monthly_elevation', default: 'Elevation Gain'),
      monthly_label_format: t('activity_tracker.js.monthly_label_format', default: '{year}-{month}'),
      error_prefix: t('activity_tracker.js.error_prefix', default: 'Error: ')
    }.to_json }}

  - if @activities.any?
    %h3= t('activity_tracker.activity_logs', default: 'Activity Logs')
    .activity-logs-wrapper
      .activity-logs-inner
        - grouped_data = Lokka::ActivityTracker::Activity.group_by_month(@activities)
        - grouped = grouped_data[:grouped]
        - grouped_data[:months].each do |month_key|
          - activities = grouped[month_key]
          - summary = Lokka::ActivityTracker::Activity.monthly_summary(activities)
          - month_label = month_key ? I18n.l(month_key, format: t('activity_tracker.month_format', default: '%Y年%-m月')) : t('activity_tracker.unknown_month', default: 'Unknown Date')
          %table.table.table-striped.activities
            %caption.activity-month-caption
              = month_label
              %span.activity-month-summary
                （
                %span.activity-stat-label= t('activity_tracker.activities_count', default: 'Activities')
                %span.activity-stat-value= "#{summary[:count]}#{t('activity_tracker.activities_count_unit', default: '回')}"
                \/
                %span.activity-stat-label= t('activity_tracker.distance', default: 'Distance')
                %span.activity-stat-value= summary[:formatted_total_distance]
                \/
                %span.activity-stat-label= t('activity_tracker.duration', default: 'Duration')
                %span.activity-stat-value= summary[:formatted_total_duration]
                \/
                %span.activity-stat-label= t('activity_tracker.elevation', default: 'Elevation Gain')
                %span.activity-stat-value= summary[:formatted_total_ascent]
                ）
            %thead
              %tr
                %th.title= t('activity_tracker.title_label', default: 'Title')
                %th.typw= t('activity_tracker.type', default: 'Type')
                %th.date= t('activity_tracker.started_at', default: 'Date')
                %th.distance= t('activity_tracker.distance', default: 'Distance')
                %th.duration= t('activity_tracker.duration', default: 'Duration')
                %th.pace= t('activity_tracker.avg_pace', default: 'Avg Pace')
                %th.elevation= t('activity_tracker.elevation', default: 'Elevation Gain')
            %tbody
              - activities.each do |activity|
                %tr
                  %td
                    %a{href: "/activities/#{activity.file_hash}"}= activity.title
                  %td.type= activity.localized_activity_type || t('activity_tracker.title', default: 'Activity')
                  %td.date= activity.started_at ? I18n.l(activity.started_at, format: t('activity_tracker.started_at_format', default: '%Y-%m-%d %H:%M')) : '-'
                  %td.distance= activity.formatted_distance || '-'
                  %td.duration= activity.formatted_duration || '-'
                  %td.pace= activity.formatted_pace || '-'
                  %td.elevation= activity.total_ascent_meters ? "#{activity.total_ascent_meters.round} m" : '-'
  - else
    %p.no-activities= t('activity_tracker.no_activities', default: 'No activities yet.')

%script{src: "#{asset_path(activity_tracker_javascript_path('index.js'))}"}
