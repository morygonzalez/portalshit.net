%section#root
  -# %h1= t('popular_entries')

  %script(src="#{asset_path(:js, '/plubin/lokka-popular_entries/javascripts/index.js')}")

  #calendar

  #entries
    - @popular_entries.each do |type, entries|
      - title = t("popular_entries_#{type}")
      %article#today.category
        %header
          %h2= title
          %ul.meta
            %li.last_updated_at== 最終更新 #{l entries.map(&:created_at).max, format: '%Y年%m月%d日 (%a)'}
            %li== 記事数 #{entries.length}
        %section
          - post = entries.delete_if {|item| entries.index(0) == item }.first
          .new-entry
            = partial :_main_entry, locals: { post: post }
          .past-entries
            - entries.each_with_index do |post, index|
              - next if index == 0
              = partial :_other_entries, locals: { post: post }
        %footer
          %p.read-more= link_to "<q>#{title}</q>をもっと読む".html_safe, %(/popular/#{type})
