#!/bin/bash

readonly APP_DIR="$(dirname "$0")/../"
readonly LOG_AGGREGATION_DIR=$(realpath "${APP_DIR}/public/log-aggregation")

yesterday_date=$(date -d "yesterday" "+%Y-%m-%d")
cp ${LOG_AGGREGATION_DIR}/access-ranking-{yesterday,${yesterday_date}}.txt
cp ${LOG_AGGREGATION_DIR}/referer-ranking-{yesterday,${yesterday_date}}.txt

files=`find ${LOG_AGGREGATION_DIR} -type f -regextype posix-egrep -regex '.+/(access|referer)-ranking-[0-9]{4}-[0-9]{2}-[0-9]{2}\.txt'`

for file in ${files} ; do
  aws s3 cp --acl "public-read" ${file} s3://backup.portalshit.net/log/
  case $? in
    0 )
      echo "Seccessfully backup the file. Now remove the file."
      rm ${file}
      ;;
    * )
      echo "Backup of the file has failed. The file remains in it's original location."
      exit 1
      ;;
  esac
done

exit 0
