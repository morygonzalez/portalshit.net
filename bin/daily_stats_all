#!/bin/bash

BIN="$(dirname "$0")"

# GA supplies at most 30 rows; filtering them can leave fewer than 30 articles.
/usr/bin/docker start -a ga-data-fetch-30d \
  | awk -v input_format=ranking -f "$BIN/lib/access_ranking.awk" \
  | sort -nr \
  | tee /var/www/app/portalshit/public/log-aggregation/access-ranking-all.txt
"$BIN/referer_ranking" all
"$BIN/client_error_ranking" all
"$BIN/cache_hit_rate" all
"$BIN/request_time" all
"$BIN/status_code" all
"$BIN/chat_api_count" all
"$BIN/ip_to_ignore"
