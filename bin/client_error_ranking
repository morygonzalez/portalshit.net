#!/bin/bash

source "$(dirname "$0")/lib/common.sh"

# 400 系レスポンスを 404 とそれ以外に分け、送信元 IP とリクエスト URI ごとに
# 集計する。404 は「件数 キー」、それ以外は「件数 キー ステータス内訳」の形式で
# 出力する。
process_client_error_ranking() {
  local period=${1:-"all"}
  local not_found_ip_output="${LOG_AGGREGATION_DIR}/client-error-404-ip-ranking-${period}.txt"
  local not_found_path_output="${LOG_AGGREGATION_DIR}/client-error-404-path-ranking-${period}.txt"
  local other_ip_output="${LOG_AGGREGATION_DIR}/client-error-other-ip-ranking-${period}.txt"
  local other_path_output="${LOG_AGGREGATION_DIR}/client-error-other-path-ranking-${period}.txt"
  local work_dir

  work_dir=$(mktemp -d)
  trap "rm -rf '${work_dir}'" EXIT HUP INT TERM

  echo "Processing Client Error Ranking ($period)"
  find "${LOG_DIR}" -name "access.log*" -print0 \
    | xargs -0 zcat -f \
    | filter_by_date "${period}" \
    | /usr/bin/gawk -f "${APP_DIR}/bin/lib/client_error_ranking.awk" \
        -v not_found_ip_file="${work_dir}/404-ips" \
        -v not_found_path_file="${work_dir}/404-paths" \
        -v other_ip_file="${work_dir}/other-ips" \
        -v other_path_file="${work_dir}/other-paths"

  rank_values "${work_dir}/404-ips" | tee "${not_found_ip_output}"
  rank_values "${work_dir}/404-paths" | tee "${not_found_path_output}"
  rank_values "${work_dir}/other-ips" | tee "${other_ip_output}"
  rank_values "${work_dir}/other-paths" | tee "${other_path_output}"

  echo "404 IP ranking saved to: ${not_found_ip_output}"
  echo "404 path ranking saved to: ${not_found_path_output}"
  echo "Other 4xx IP ranking saved to: ${other_ip_output}"
  echo "Other 4xx path ranking saved to: ${other_path_output}"

  rm -rf "${work_dir}"
  trap - EXIT HUP INT TERM
}

rank_values() {
  local input=$1

  if [ -f "${input}" ]; then
    LC_ALL=C sort -nr "${input}" | head -100
  fi
}

main() {
  local period="${1:-}"

  if [ $# -eq 0 ]; then
    process_client_error_ranking
  else
    case "$period" in
      [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]|today|yesterday|all)
        process_client_error_ranking "$period"
        ;;
      *)
        echo "Usage: $0 {[YYYY-MM-DD|today|yesterday|all]}"
        exit 1
        ;;
    esac
  fi
}

main "$@"
