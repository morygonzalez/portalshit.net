#!/bin/bash

source "$(dirname "$0")/lib/common.sh"

# 設定読み込み
source "${CONFIG_DIR}/notify_errors.conf"

# ポジションファイル
POSITION_FILE="${LOG_DIR}/.notify_errors_position"
ACCESS_LOG="${LOG_DIR}/access.log"

# LTSVフィールドを抽出する関数
extract_ltsv_field() {
  local line="$1"
  local field="$2"
  echo "$line" | grep -oP "${field}:[^\t]*" | sed "s/^${field}://"
}

# LTSV行を人間が読みやすい形式に変換する関数
format_error_line() {
  local line="$1"
  local time=$(extract_ltsv_field "$line" "time")
  local request_uri=$(extract_ltsv_field "$line" "request_uri")
  local request_method=$(extract_ltsv_field "$line" "request_method")
  local status=$(extract_ltsv_field "$line" "status")
  local remote_addr=$(extract_ltsv_field "$line" "remote_addr")
  local request_time=$(extract_ltsv_field "$line" "request_time")

  cat <<EOM
---
発生時刻: ${time}
リクエスト: ${request_method} ${request_uri}
ステータス: ${status}
リモートアドレス: ${remote_addr}
レスポンスタイム: ${request_time}s
EOM
}

# メール本文を組み立てる関数
build_mail_body() {
  local error_lines="$1"
  local total_count="$2"
  local display_count="$3"

  local body="[portalshit.net] サーバーエラー通知

以下のリクエストでサーバーエラーが発生しました。
"

  local count=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    count=$((count + 1))
    if [ "$count" -le "$display_count" ]; then
      body+="
$(format_error_line "$line")"
    fi
  done <<< "$error_lines"

  body+="
---

合計: ${total_count}件"

  if [ "$total_count" -gt "$display_count" ]; then
    body+="（先頭${display_count}件のみ表示、他$((total_count - display_count))件省略）"
  fi

  echo "$body"
}

# メール送信
send_notification() {
  local body="$1"

  if [ "$DRY_RUN" = "true" ]; then
    echo "=== ドライラン: メール送信をスキップ ==="
    echo "To: ${NOTIFY_TO}"
    echo "From: ${NOTIFY_FROM}"
    echo ""
    echo "$body"
    return 0
  fi

  aws sesv2 send-email \
    --region "${AWS_REGION}" \
    --from-email-address "${NOTIFY_FROM}" \
    --destination "ToAddresses=${NOTIFY_TO}" \
    --content "Simple={Subject={Data='[portalshit] サーバーエラーが発生しました',Charset=UTF-8},Body={Text={Data=$(printf '%q' "$body"),Charset=UTF-8}}}"
}

# メイン処理
main() {
  local dry_run=false
  local test_mode=false

  for arg in "$@"; do
    case "$arg" in
      --dry-run)
        DRY_RUN=true
        ;;
      --test)
        DRY_RUN=true
        test_mode=true
        ;;
      *)
        echo "Usage: $0 [--dry-run|--test]"
        exit 1
        ;;
    esac
  done

  DRY_RUN="${DRY_RUN:-false}"

  # アクセスログの存在確認
  if [ ! -f "$ACCESS_LOG" ]; then
    echo "Access log not found: ${ACCESS_LOG}" >&2
    exit 1
  fi

  # テストモード: 最新1000行から検索
  if [ "$test_mode" = "true" ]; then
    local new_lines
    new_lines=$(tail -n 1000 "$ACCESS_LOG")
    local error_lines
    error_lines=$(echo "$new_lines" | grep -P "\t${NOTIFY_STATUS_PATTERN}\t" \
      | grep -vP 'request_uri:\S+\.(css|js|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|map)(\?|	)')

    if [ -z "$error_lines" ]; then
      echo "テストモード: エラーは見つかりませんでした"
      exit 0
    fi

    local total_count
    total_count=$(echo "$error_lines" | wc -l)
    local body
    body=$(build_mail_body "$error_lines" "$total_count" "$MAX_ERRORS_IN_MAIL")
    echo "$body"
    exit 0
  fi

  # 前回のオフセットを読み込む
  local last_position=0
  if [ -f "$POSITION_FILE" ]; then
    last_position=$(cat "$POSITION_FILE")
  fi

  # 現在のファイルサイズを取得
  local current_size
  current_size=$(stat -c %s "$ACCESS_LOG")

  # ログローテーション検知: ファイルサイズが前回より小さくなっていたらリセット
  if [ "$current_size" -lt "$last_position" ]; then
    last_position=0
  fi

  # 差分がなければ終了
  if [ "$current_size" -eq "$last_position" ]; then
    exit 0
  fi

  # 差分を読み取る
  local new_lines
  new_lines=$(dd if="$ACCESS_LOG" bs=1 skip="$last_position" count=$((current_size - last_position)) 2>/dev/null)

  # ポジションを更新
  echo "$current_size" > "$POSITION_FILE"

  # エラー行を抽出
  local error_lines
  error_lines=$(echo "$new_lines" | grep -P "\t${NOTIFY_STATUS_PATTERN}\t" \
    | grep -vP 'request_uri:\S+\.(css|js|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|map)(\?|	)')

  # エラーがなければ終了
  if [ -z "$error_lines" ]; then
    exit 0
  fi

  # 件数カウント
  local total_count
  total_count=$(echo "$error_lines" | wc -l)

  # メール本文を組み立て
  local body
  body=$(build_mail_body "$error_lines" "$total_count" "$MAX_ERRORS_IN_MAIL")

  # メール送信
  send_notification "$body"
  echo "$(date '+%Y-%m-%d %H:%M:%S') Sent error notification: ${total_count} errors"
}

main "$@"
