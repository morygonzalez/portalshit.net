#!/bin/bash

source "$(dirname "$0")/lib/common.sh"

# 設定読み込み
source "${CONFIG_DIR}/notify_errors.conf"

POSITION_FILE="${LOG_DIR}/.notify_errors_position"
PUMA_POSITION_FILE="${LOG_DIR}/.notify_errors_puma_position"
ACCESS_LOG="${LOG_DIR}/access.log"
PUMA_ERROR_LOG="${LOG_DIR}/puma_error.log"
FORMAT_AWK="${APP_DIR}/bin/lib/format_error_lines.awk"

# 静的ファイルを除外しつつエラー行を抽出
filter_errors() {
  grep -P "\t${NOTIFY_STATUS_PATTERN}\t" \
    | grep -vP 'request_uri:\S+\.(css|js|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|map)(\?|	)'
}

# エラー行を awk で整形してメール本文を生成
build_mail_body() {
  /usr/bin/gawk -v max_errors="$MAX_ERRORS_IN_MAIL" -f "$FORMAT_AWK"
}

# メール送信
send_notification() {
  local body="$1"
  local subject="[portalshit] サーバーエラーが発生しました"

  local json_file
  json_file=$(mktemp)
  trap "rm -f '$json_file'" RETURN

  # JSON ファイル経由で渡すことでクォーティング問題を回避
  python3 -c "
import json, sys
payload = {
    'Content': {
        'Simple': {
            'Subject': {'Data': sys.argv[1], 'Charset': 'UTF-8'},
            'Body': {'Text': {'Data': sys.argv[2], 'Charset': 'UTF-8'}}
        }
    },
    'FromEmailAddress': sys.argv[3],
    'Destination': {'ToAddresses': [sys.argv[4]]}
}
json.dump(payload, open(sys.argv[5], 'w'), ensure_ascii=False)
" "$subject" "$body" "$NOTIFY_FROM" "$NOTIFY_TO" "$json_file"

  aws sesv2 send-email \
    --region "${AWS_REGION}" \
    --cli-input-json "file://${json_file}"
}

# ポジションファイルから前回位置を取得
get_last_position() {
  local pos_file="${1:-$POSITION_FILE}"
  if [ -f "$pos_file" ]; then
    cat "$pos_file"
  else
    echo 0
  fi
}

# ログの差分を読み取る
read_new_lines() {
  local log_file="$1"
  local last_position="$2"
  local current_size="$3"

  dd if="$log_file" bs=1 skip="$last_position" count=$((current_size - last_position)) 2>/dev/null
}

# ポジションを更新
save_position() {
  local pos_file="${1:-$POSITION_FILE}"
  local position="$2"
  echo "$position" > "$pos_file"
}

# puma_error.log からバックトレースを抽出
# エラーヘッダ行とアプリコードのフレームのみ残し、gem フレームは省略
extract_backtraces() {
  grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} |^\t.*/releases/' \
    | sed 's|/var/www/deploys/portalshit/releases/[0-9]*/|app/|'
}

# puma_error.log の差分を取得
read_puma_backtraces() {
  local mode="$1"

  if [ ! -f "$PUMA_ERROR_LOG" ]; then
    return
  fi

  local puma_lines=""
  if [ "$mode" = "test" ]; then
    puma_lines=$(tail -n 500 "$PUMA_ERROR_LOG")
  else
    local puma_last_position puma_current_size
    puma_last_position=$(get_last_position "$PUMA_POSITION_FILE")
    puma_current_size=$(stat -c %s "$PUMA_ERROR_LOG")

    # ログローテーション検知
    if [ "$puma_current_size" -lt "$puma_last_position" ]; then
      puma_last_position=0
    fi

    # 差分がなければ終了
    if [ "$puma_current_size" -eq "$puma_last_position" ]; then
      return
    fi

    puma_lines=$(read_new_lines "$PUMA_ERROR_LOG" "$puma_last_position" "$puma_current_size")
    # 後で save するためにサイズを出力
    echo "$puma_current_size" > "${PUMA_POSITION_FILE}.pending"
  fi

  [ -z "$puma_lines" ] && return
  echo "$puma_lines" | extract_backtraces
}

# メイン処理
main() {
  local dry_run=false
  local test_mode=false

  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run=true ;;
      --test)    dry_run=true; test_mode=true ;;
      *)
        echo "Usage: $0 [--dry-run|--test]"
        exit 1
        ;;
    esac
  done

  if [ ! -f "$ACCESS_LOG" ]; then
    echo "Access log not found: ${ACCESS_LOG}" >&2
    exit 1
  fi

  # エラー行を取得
  local error_lines
  if [ "$test_mode" = "true" ]; then
    error_lines=$(tail -n 1000 "$ACCESS_LOG" | filter_errors)
  else
    local last_position current_size
    last_position=$(get_last_position)
    current_size=$(stat -c %s "$ACCESS_LOG")

    # ログローテーション検知
    if [ "$current_size" -lt "$last_position" ]; then
      last_position=0
    fi

    # 差分がなければ終了
    if [ "$current_size" -eq "$last_position" ]; then
      exit 0
    fi

    error_lines=$(read_new_lines "$ACCESS_LOG" "$last_position" "$current_size" | filter_errors)
  fi

  if [ -z "$error_lines" ]; then
    # エラーなしでもポジションは進める（同じ範囲を再読みしないため）
    if [ -n "$current_size" ]; then
      save_position "$POSITION_FILE" "$current_size"
      # puma 側もポジションを進める
      if [ -f "$PUMA_ERROR_LOG" ]; then
        stat -c %s "$PUMA_ERROR_LOG" > "$PUMA_POSITION_FILE"
      fi
    fi
    [ "$test_mode" = "true" ] && echo "テストモード: エラーは見つかりませんでした"
    exit 0
  fi

  # awk でメール本文を生成
  local body
  body=$(echo "$error_lines" | build_mail_body)

  # puma_error.log からバックトレースを取得して本文に追加
  local backtraces
  if [ "$test_mode" = "true" ]; then
    backtraces=$(read_puma_backtraces "test")
  else
    backtraces=$(read_puma_backtraces)
  fi

  if [ -n "$backtraces" ]; then
    body="${body}

========================================
Backtraces (puma_error.log)
========================================
${backtraces}"
  fi

  if [ "$dry_run" = "true" ]; then
    echo "=== ドライラン: メール送信をスキップ ==="
    echo "To: ${NOTIFY_TO}"
    echo "From: ${NOTIFY_FROM}"
    echo ""
    echo "$body"
    exit 0
  fi

  if send_notification "$body"; then
    save_position "$POSITION_FILE" "$current_size"
    # puma_error.log のポジションも確定
    if [ -f "${PUMA_POSITION_FILE}.pending" ]; then
      mv "${PUMA_POSITION_FILE}.pending" "$PUMA_POSITION_FILE"
    fi
    local total_count
    total_count=$(echo "$error_lines" | wc -l)
    echo "$(date '+%Y-%m-%d %H:%M:%S') Sent error notification: ${total_count} errors"
  else
    echo "$(date '+%Y-%m-%d %H:%M:%S') Failed to send notification. Position not advanced." >&2
    exit 1
  fi
}

main "$@"
