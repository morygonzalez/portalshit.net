#!/bin/bash

source "$(dirname "$0")/lib/common.sh"

# 検索キーワードランキング処理
process_query_term_ranking() {
  local target=${1:-"all"}
  local output="${LOG_AGGREGATION_DIR}/query-term-ranking-${target}.txt"
  local ignore_ip=""

  case "${target}" in
    all)
      ignore_ip="-"
      ;;
    visitor)
      ignore_ip="${IP_TO_IGNORE}"
      ;;
    *)
      exit 1
      ;;
  esac

  echo "Processing Query Term Ranking ($target)"
  find "${LOG_DIR}" -name "access.log*" \
    | xargs zcat -f \
    | grep -vP "remote_addr:\(${ignore_ip}\)" \
    | cut -f5 \
    | grep 'query=' \
    | sed -r "s/request_uri:.+?query=|&page=.|'//g" \
    | grep -vP "(^-$|\.cn|alert|ORDER%20BY%201|nvOpzp|\(|\)|\.\.\/|%3d|%27|unhex)" \
    | tr -s "\n" | tr '[:upper:]' '[:lower:]' \
    | awk '{count[$0]++} END {for (word in count) print count[word], word}' \
    | sort -nr | head -100 \
    | nkf -w --url-input \
    | awk '
      BEGIN { OFS=" " }
      {
        # $1 は出現回数、残りが単語となるのでフィールドを再構築
        count = $1;
        $1 = "";
        gsub(/^ +/, "", $0);  # 先頭の空白を削除
        word = $0;
        words[NR] = word;
        counts[NR] = count;
      }
      END {
        for (i = 1; i <= NR; i++) {
          reject = 0;
          for (j = 1; j <= NR; j++) {
            if (i != j && index(words[j], words[i]) > 0) {
              reject = 1;
              break;
            }
          }
          if (!reject)
            print counts[i], words[i];
        }
      }' \
    | tee "${output}"

  echo "Query term ranking saved to: ${output}"
}

# メイン処理
main() {
  local target="${1:-}"

  if [ $# -eq 0 ]; then
    process_query_term_ranking
  else
    case "$target" in
      all|visitor)
        process_query_term_ranking "$target"
        ;;
      *)
        echo "Usage: $0 {query_term_ranking} {[all|visitor]}"
        exit 1
        ;;
    esac
  fi
}

main "$@"
