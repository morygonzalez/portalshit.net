#!/bin/bash

source "$(dirname "$0")/lib/common.sh"

# キャッシュヒット率集計処理
process_cache_hit_rate() {
  local period=${1:-"all"}
  local output="${LOG_AGGREGATION_DIR}/cache-hit-rate-${period}.txt"
  local awk_script

  case "$period" in
    today|yesterday|[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9])
      awk_script="${APP_DIR}/bin/lib/cache_hit_rate_hourly.awk"
      ;;
    *)
      awk_script="${APP_DIR}/bin/lib/cache_hit_rate_daily.awk"
      ;;
  esac

  echo "Processing Cache Hit Rate ($period)"
  find "${LOG_DIR}" -name "access.log*" \
    | xargs zcat -f \
    | filter_by_date "${period}" \
    | grep 'cache_status:' | grep -v 'cache_status:-' \
    | /usr/bin/gawk -f "${awk_script}" \
    | tee "${output}"

  echo "Cache hit rate saved to: ${output}"
}

# メイン処理
main() {
  local period="${1:-}"

  if [ $# -eq 0 ]; then
    process_cache_hit_rate
  else
    case "$period" in
      [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]|today|yesterday|all)
        process_cache_hit_rate "$period"
        ;;
      *)
        echo "Usage: $0 {[YYYY-MM-DD|today|yesterday|all]}"
        exit 1
        ;;
    esac
  fi
}

main "$@"
