#!/usr/bin/env ruby
# frozen_string_literal: true

# Flickr Data などで取得済みの画像を S3 へ移し、記事内の staticflickr URL を
# resources.portalshit.net へ置き換える。既定は読み取り専用のドライラン。
#
# 例:
#   RACK_ENV=production bundle exec ruby bin/migrate_flickr_images \
#     --images /path/to/flickr-data
#
# 確認後に反映:
#   RACK_ENV=production bundle exec ruby bin/migrate_flickr_images \
#     --images /path/to/flickr-data --apply
#
# 過去の実行で直接参照になった画像URLを表示用 imageproxy URL へ直す:
#   RACK_ENV=production bundle exec ruby bin/migrate_flickr_images \
#     --images /path/to/empty-directory --existing-manifest /path/to/previous-manifest.json

require 'csv'
require 'json'
require 'optparse'
require 'time'
require_relative '../init'
require_relative '../public/plugin/lokka-photo_gallery/lib/lokka/photo_gallery/flickr_image_migrator'
require_relative '../public/plugin/lokka-photo_gallery/lib/lokka/photo_gallery/s3_uploader'

options = {
  apply: false,
  keep_gps: false,
  removal_photo_ids: [],
  manifest: File.join('tmp', 'flickr-image-migration.json')
}

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: bin/migrate_flickr_images --images DIRECTORY [options]'
  opts.on('--images DIRECTORY', '取得済み Flickr 画像のディレクトリ（再帰検索）') do |value|
    options[:images] = value
  end
  opts.on('--map CSV', '自動対応できない画像用の photo_id,path CSV') { |value| options[:map] = value }
  opts.on('--existing-manifest FILE', '既存の移行計画にある直接画像URLも表示用URLへ変換') do |value|
    options[:existing_manifest] = value
  end
  opts.on('--remove-photo-id PHOTO_ID', 'ローカル保存せず記事から削除する photo ID（複数指定可）') do |value|
    options[:removal_photo_ids] << value
  end
  opts.on('--manifest FILE', '移行計画の出力先') { |value| options[:manifest] = value }
  opts.on('--apply', 'S3アップロードとDB更新を実行') { options[:apply] = true }
  opts.on('--keep-gps', '画像のGPS EXIFを残す（既定では削除）') { options[:keep_gps] = true }
  opts.on('-h', '--help', 'ヘルプを表示') do
    puts opts
    exit
  end
end

parser.parse!
abort parser.to_s unless options[:images]
abort "画像ディレクトリが見つかりません: #{options[:images]}" unless Dir.exist?(options[:images])

def read_explicit_mapping(csv_path)
  return {} unless csv_path

  base_directory = File.dirname(File.expand_path(csv_path))
  CSV.read(csv_path, headers: true).each_with_object({}) do |row, mapping|
    photo_id = row['photo_id'].to_s.strip
    path = row['path'].to_s.strip
    abort '対応表CSVには photo_id,path ヘッダーが必要です' if photo_id.empty? || path.empty?

    mapping[photo_id] = File.expand_path(path, base_directory)
  end
end

def read_existing_resource_urls(manifest_path)
  return [] unless manifest_path
  abort "移行計画が見つかりません: #{manifest_path}" unless File.file?(manifest_path)

  plan = JSON.parse(File.read(manifest_path))
  plan.fetch('photos').filter_map do |photo|
    next unless photo['status'] == 'resolved'

    resource_url = photo['resource_url'] || photo['target_url']
    resource_url if resource_url.to_s.start_with?("#{Lokka::PhotoGallery::RESOURCE_BASE_URL}/")
  end.uniq
rescue JSON::ParserError, KeyError => e
  abort "移行計画を読み込めません: #{e.message}"
end

Lokka::Database.connect

entries = Entry.unscoped.where(
  <<~SQL.squish,
    body LIKE :staticflickr OR body LIKE :static_flickr OR body LIKE :flickr_embed OR
    body LIKE :flickr_script OR body LIKE :flickr_photo_link
  SQL
  staticflickr: '%staticflickr.com%',
  static_flickr: '%static.flickr.com%',
  flickr_embed: '%data-flickr-embed%',
  flickr_script: '%embedr.flickr.com/assets/client-code.js%',
  flickr_photo_link: '%flickr.com/photos/%'
).to_a
existing_resource_urls = read_existing_resource_urls(options[:existing_manifest])
unless existing_resource_urls.empty?
  resource_entries = Entry.unscoped.where('body LIKE ?', '%resources.portalshit.net%').to_a.select do |entry|
    existing_resource_urls.any? { |url| entry.raw_body.to_s.include?(url) }
  end
  entries = (entries + resource_entries).uniq(&:id)
end

migrator = Lokka::PhotoGallery::FlickrImageMigrator.new(
  entries: entries,
  image_directory: options[:images],
  explicit_mapping: read_explicit_mapping(options[:map]),
  removal_photo_ids: options[:removal_photo_ids],
  existing_resource_urls: existing_resource_urls
)
plan = migrator.build_plan
plan[:generated_at] = Time.now.iso8601
plan[:mode] = options[:apply] ? 'apply' : 'dry-run'

manifest_path = File.expand_path(options[:manifest])
FileUtils.mkdir_p(File.dirname(manifest_path))
File.write(manifest_path, JSON.pretty_generate(plan))

puts "対象記事: #{plan[:entry_count]}"
puts "埋め込み記法を除去: #{plan[:markup_cleanup_entry_count]}"
puts "画像のFlickrリンクを解除: #{plan[:flickr_image_link_count]}"
puts "見出し前の空行を復元: #{plan[:heading_spacing_repair_count]}"
puts "既存の直接画像URLを変換: #{plan[:existing_resource_image_count]}"
puts "Flickr URL: #{plan[:source_url_count]}"
puts "photo ID: #{plan[:photo_count]}"
puts "対応済み: #{plan[:resolved_count]}"
puts "削除指定: #{plan[:removal_count]}"
puts "不足: #{plan[:missing_count]}"
puts "重複候補: #{plan[:ambiguous_count]}"
puts "移行計画: #{manifest_path}"

unless plan[:missing_count].zero? && plan[:ambiguous_count].zero?
  warn '未解決の画像があります。manifestを確認し、ファイル名または --map CSV で対応付けてください。'
  exit 2
end

unless options[:apply]
  puts 'ドライランのため変更していません。確認後、同じ引数に --apply を加えて実行してください。'
  exit
end

timestamp = Time.now.strftime('%Y%m%d%H%M%S')
backup_path = File.expand_path(File.join('tmp', "flickr-entry-backup-#{timestamp}.json"))
backup = entries.map do |entry|
  { id: entry.id, title: entry.title, body: entry.raw_body }
end
FileUtils.mkdir_p(File.dirname(backup_path))
File.write(backup_path, JSON.pretty_generate(backup))
puts "記事本文バックアップ: #{backup_path}"

result = migrator.apply!(
  plan,
  uploader: Lokka::PhotoGallery::S3Uploader.new,
  strip_gps: !options[:keep_gps]
)

puts "S3処理画像: #{result[:uploaded_photos]}"
puts "削除画像: #{result[:removed_photos]}"
puts "更新記事: #{result[:updated_entries]}"
puts '完了しました。ページ、フィード、OGP画像を確認してください。'
